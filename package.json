{
  "name": "time-master",
  "version": "2.1.3",
  "description": "High-performance productivity enforcer for deep work.",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently \"vite --port 5315\" \"wait-on tcp:5315 && electron .\"",
    "build": "vite build",
    "compile": "npm run build && electron-builder",
    "compile:mac": "npm run build && electron-builder --mac",
    "test": "node --experimental-test-coverage --test src/__tests__/*.test.mjs"
  },
  "build": {
    "appId": "com.timemaster.app",
    "productName": "Time Master",
    "publish": [
      {
        "provider": "github",
        "owner": "BTawaifi",
        "repo": "Time-Master"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "keywords": [],
  "author": {
    "name": "BTawaifi",
    "email": "btawaifi@users.noreply.github.com"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "lucide-react": "^0.575.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  }
}